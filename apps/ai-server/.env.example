# apps/ai-server 환경변수 예시 — 키 이름과 용도만 기재한다. 실제 값/기본 호스트는 넣지 않는다.
# 실제 값은 apps/ai-server/.env 에 채운다 (gitignored, 절대 커밋 금지).
# 각 키의 소비 코드: src/config.py, src/rag/auth.py, src/rag/embed.py, src/rag/crypto.py,
# src/rag_chat.py, src/rag/tooling/*.py — 이 파일과 실제 코드가 어긋나면 코드가 항상 우선.
# PLAN-2026-W28-D 1b (filemanager) — VAL-005 재발 방지: placeholder-only, 실 IP/UUID/비밀값 금지.

# ── Upstage Solar Pro3 (채팅 LLM) — src/config.py ──────────────────────────
UPSTAGE_API_KEY=              # Upstage API 키. src/config.py 소비. 필수 — 미설정 시 Upstage 어댑터 호출 실패
UPSTAGE_BASE_URL=             # Upstage OpenAI 호환 base URL. src/config.py 소비. 선택 (기본값 코드에 내장)
UPSTAGE_CHAT_MODEL=           # Upstage 채팅 모델명. src/config.py 소비. 선택 (기본값 solar-pro3)

# ── LG K-EXAONE (Friendli) — src/config.py ─────────────────────────────────
LG_K_EXAONE_API_KEY=          # Friendli API 키. src/config.py 소비. 필수 (K-EXAONE 어댑터 사용 시)
LG_K_EXAONE_ENDPOINT_ID=      # Friendli dedicated endpoint ID(모델 파라미터로 사용). src/config.py + agent_model_registry.yaml 소비. 필수 (K-EXAONE 사용 시)
LG_K_EXAONE_BASE_URL=         # Friendli dedicated base URL. src/config.py 소비. 선택 (기본값 코드에 내장)

# ── SKT A.X — src/config.py ─────────────────────────────────────────────────
SKT_A_X_API_KEY=              # SKT A.X API 키. src/config.py 소비. 필수 (A.X 어댑터 사용 시)
SKT_A_X_REST_BASE_URL=        # SKT A.X REST 게이트웨이 base URL. src/config.py 소비. 선택 (기본값 코드에 내장)
SKT_A_X_WS_BASE_URL=          # SKT A.X 스트리밍 STT용 WebSocket base URL. src/config.py 소비. 선택 (기본값 없음 — 스트리밍 STT 사용 시 사실상 필수)
SKT_A_X_LLM_MODEL=            # SKT A.X LLM 모델 식별자. src/config.py 소비. 선택 (기본값 A.X-K1)
SKT_A_X_STT_STREAMING_MODEL=  # SKT A.X 스트리밍 STT 모델. src/config.py + agent_model_registry.yaml 소비. 선택 (기본값 없음 — 스트리밍 STT 사용 시 사실상 필수)
SKT_A_X_STT_BATCH_MODEL=      # SKT A.X 배치 STT 모델. src/config.py 소비. 선택 (기본값 없음 — 배치 STT 사용 시 사실상 필수)

# ── 경로 / 앱 설정 — src/config.py ───────────────────────────────────────────
MODEL_REGISTRY_PATH=          # agent_model_registry.yaml 경로 override. src/config.py 소비. 선택 (기본값: src/routing/agent_model_registry.yaml)
PROMPTS_BASE_DIR=             # 프롬프트 템플릿 기준 디렉터리(프로젝트 루트 상대경로). src/config.py 소비. 선택 (기본값 docs/ai/prompts)
LOG_LEVEL=                    # 로깅 레벨. src/config.py 소비. 선택 (기본값 INFO)
DEBUG=                        # 디버그 모드. src/config.py 소비. 선택 (기본값 false)

# ── Database — src/config.py, src/rag/tooling/_db.py ────────────────────────
DATABASE_URL=                 # Postgres DSN (async: +asyncpg). RAG 검색·시뮬 적재에 사용. 필수 (RAG 라우터/툴링 사용 시) — 형식 예: postgresql+asyncpg://<user>:<password>@<host>:5432/neurosync (주석용 예시일 뿐, 실값 금지)
ENCRYPTION_KEY=                # AES-256-GCM 키 (base64-urlsafe 32B). src/config.py, src/rag/crypto.py 소비. api 서비스와 동일 값 필수. 미설정 시 암호화된 필드는 복호화 없이 제외되고 명시 로깅됨 (ADR-013 S2)

# ── RAG 라우터 인증 — src/rag/auth.py (ADR-013 옵션 a, VAL-005; RETIRED, ADR-017) ──
# UNUSED as of ADR-017 (2026-07-09): RAG runs in-process only, permanently — no
# HTTP-served RAG now or at deployment (user decision, categorical). `src/rag/route.py`
# and `src/rag/auth.py` are retired-not-deleted (unmounted from `main.py`, REV-013);
# neither key below has a live consumer. Do not set either in any deployed environment.
# If RAG-over-HTTP is ever reinstated, `auth.py`'s fail-closed bearer auth must be
# reactivated first, gated by a fresh ADR + a VAL-005 reopening review — unauthorized
# remount is not licensed.
NS_RAG_API_KEY=                # UNUSED (ADR-017) — retired POST /ai/rag/grounding bearer key, no live consumer. src/rag/auth.py (retired, unmounted).
NS_RAG_DEV_MODE=               # UNUSED (ADR-017) — RAG router unmounted; this dev-mode auth bypass has no live consumer. src/rag/auth.py (retired, unmounted).

# ── RAG 임베딩 — src/rag/embed.py ────────────────────────────────────────────
EMBED_BASE_URL=                # Upstage 임베딩 전용 base URL (.../solar 접미 필요, 채팅용 UPSTAGE_BASE_URL과 별개). src/rag/embed.py 소비. 선택 (기본값 코드에 내장)
UPSTAGE_PASSAGE_MODEL=         # Upstage passage 임베딩 모델명. src/rag/embed.py 소비. 선택 (기본값 solar-embedding-1-large-passage)
UPSTAGE_QUERY_MODEL=           # Upstage query 임베딩 모델명. src/rag/embed.py 소비. 선택 (기본값 solar-embedding-1-large-query)
EMBED_DUMMY=                   # 1이면 키 없이 결정적 더미 벡터 사용(배관 테스트용, 실제 임베딩 호출 안 함). src/rag/embed.py 소비. 선택 (기본값 0)

# ── RAG 테스트 클라이언트 — src/rag_chat.py (ai-server 외부에서 실행하는 HTTP 클라이언트 스크립트) ──
NS_RAG_URL=                    # 접속 대상 ai-server 베이스 URL. src/rag_chat.py 소비. 선택 (기본값 http://localhost:8001) — 원격 접속 시 반드시 명시
NS_PATIENT_ID=                 # 조회할 환자 UUID 또는 VP-00N 별칭. src/rag_chat.py 소비. 선택 (기본값 없음 → my_past 미조회)
NS_K=                          # 슬롯별 top-k, 1~10 범위. src/rag_chat.py 소비. 선택 (기본값 3)

# ── RAG 코퍼스 적재 툴링 — src/rag/tooling/load_case_cards.py, load_qa.py ────
CASE_DATA_DIR=                 # 심리상담 데이터(16.심리상담_데이터) 원본 경로. src/rag/tooling/load_case_cards.py 소비. 필수 (load_case_cards 실행 시)
QA_DATA_DIR=                   # 전문 의학지식 데이터(08.전문_의학지식_데이터) 원본 경로. src/rag/tooling/load_qa.py 소비. 필수 (load_qa 실행 시)
