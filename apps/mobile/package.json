{
  "name": "@neuro-sync/mobile",
  "version": "0.1.0",
  "private": true,
  "description": "Neuro-Sync patient mobile app (Expo SDK 54 + expo-router)",
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start --dev-client",
    "start": "expo start",
    "ios": "expo run:ios",
    "android": "expo run:android",
