{
  "name": "@neuro-sync/mobile",
  "version": "0.1.0",
  "private": true,
  "description": "Neuro-Sync patient mobile app (Expo SDK 52 + expo-router)",
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start --dev-client",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "build": "echo 'use EAS Build: eas build --platform all'",
    "typecheck": "tsc --noEmit",
    "lint": "echo 'no lint configured yet' && exit 0",
    "test": "echo 'no tests yet' && exit 0",
    "clean": "rm -rf .expo node_modules/.cache"
  },
  "dependencies": {
    "@neuro-sync/contracts": "workspace:*",
    "expo": "~52.0.0",
    "expo-clipboard": "^7.0.1",
    "expo-constants": "~17.0.0",
    "expo-crypto": "^14.0.2",
    "expo-haptics": "^14.0.1",
    "expo-linking": "~7.0.0",
    "expo-router": "~4.0.0",
    "expo-secure-store": "~14.0.0",
    "expo-status-bar": "~2.0.0",
    "react": "18.3.1",
    "react-native": "0.76.9",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.4.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/react": "~18.3.12",
    "typescript": "^5.6.3"
  }
