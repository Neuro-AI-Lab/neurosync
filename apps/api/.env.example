# Neuro-Sync Platform API — environment template.
# Copy to `.env` and fill in. NEVER commit `.env` (gitignored).

# Database — match infra/deploy/docker-compose.yml
DATABASE_URL=postgresql+asyncpg://neurosync:dev@localhost:5432/neurosync

# JWT — generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Column encryption — AES-256 key, base64-urlsafe(32 bytes)
# Generate with: python -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
ENCRYPTION_KEY=

# Password policy
PASSWORD_MIN_LENGTH=12
ARGON2_MEMORY_COST_KIB=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=4

# Age policy
MINOR_AGE_CUTOFF=14

# CORS — Demo permissive; Phase 2 restricts to known origins
CORS_ORIGINS=["*"]

# AI server (Phase 1a Day 7+)
AI_SERVER_URL=http://localhost:8001
