{
  "name": "neuro-sync",
  "version": "0.1.0",
  "private": true,
  "description": "Neuro-Sync monorepo root (pnpm + Turborepo for JS apps; Python apps managed independently with uv)",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20.11.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "turbo": "^2.3.0",
    "typescript": "^5.6.3"
  },
  "pnpm": {
    "overrides": {
      "react": "18.3.1",
      "react-dom": "18.3.1",
      "@types/react": "18.3.31",
      "@types/react-dom": "18.3.7"
    },
    "peerDependencyRules": {
      "allowedVersions": {
        "react": "18.3.1",
        "react-dom": "18.3.1"
      }
    }
  }
}
